{
  "name": "@dcv/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --external:ws --outfile=dist/main.js",
    "start": "node dist/main.js",
    "dev": "esbuild src/main.ts --bundle --platform=node --format=esm --external:ws --outfile=dist/main.js --watch & node --watch dist/main.js"
  },
  "dependencies": {
    "@dcv/engine": "*",
    "@dcv/protocol": "*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.0"
  }
}
