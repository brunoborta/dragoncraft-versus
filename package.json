{
  "name": "dragoncraft-versus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @dcv/web",
    "build": "npm run build -w @dcv/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/engine/tsconfig.json && tsc -p packages/ai/tsconfig.json && tsc -p apps/web/tsconfig.json"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26.6.3",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
